{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lync-to-mart-staging",
  "main": "src/worker.mjs",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [],
  "compatibility_date": "2026-09-25",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none"},
  "d1_databases": [{"binding":"DB","database_name":"lync-to-mart-staging","database_id":"2565c489-f0d4-43a9-8ea2-1bde5bb6fde3","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"lync-to-mart-staging-media"}],
  "triggers": {"crons":["*/15 * * * *"]},
  "vars": {"MART_DOMAINS_ENABLED":"true","MART_DOMAIN_MAX_HOSTNAMES":"90","MART_DOMAIN_ZONE_ID":"f0b5797bfb2571e56c55b7dedd8fbcbc","DOMAIN_PREPARATION_ENABLED":"true","THAIMART_LEGACY_RESOLVE":"true","BILLING_ENABLED":"true","STRIPE_TEST_EMAILS":"paiboon@chiistudio.com","SIGNUP_ENABLED":"true","IMPORT_HOSTS":"thaimart.com","CHECKOUT_HOSTS":"thaimart.com","APP_ENV":"staging","STAGING_ADMIN_SHOP_ID":"e635859a-7587-4568-b0c6-7a707f7e62fa","STAGING_TEST_SHOP_ID":"e635859a-7587-4568-b0c6-7a707f7e62fa","STAGING_TEST_PLAN":"free","MAIL_FROM":"Lync to Mart <mart@lyncto.link>","MAIL_REPLY_TO":"contact@iresauce.com","RECOVERY_ORIGIN":"https://lync-to-mart-staging.paiboon.workers.dev"}
}

