{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lync-to-mart-production",
  "main": "src/worker.mjs",
  "workers_dev": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "mart.lyncto.link",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lync-to-mart-production",
      "database_id": "d63c6432-2386-403a-a8b3-c2522f597f13",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lync-to-mart-production-media"
    }
  ],
  "vars": {
    "BILLING_ENABLED": "false",
    "SIGNUP_ENABLED": "false",
    "IMPORT_HOSTS": "thaimart.com",
    "CHECKOUT_HOSTS": "thaimart.com",
    "APP_ENV": "production",
    "MAIL_FROM": "Lync to Mart <mart@lyncto.link>",
    "MAIL_REPLY_TO": "contact@iresauce.com",
    "RECOVERY_ORIGIN": "https://mart.lyncto.link"
  },
  "preview_urls": false
}
